---
import '../styles/global.css';
import SubpageHeader from '../components/SubpageHeader.astro';
import SubpageFooter from '../components/SubpageFooter.astro';
import { facts } from '../data/site';

interface Crumb { name: string; href: string; }
interface Props {
  title: string;
  description: string;
  imagePath?: string;
  breadcrumbs?: Crumb[];
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  imagePath = '/images/senba-hero.jpg',
  breadcrumbs = [],
  structuredData = [],
} = Astro.props;

if (!Astro.site) throw new Error('Astro site configuration is required.');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(imagePath, Astro.site);
const attractionId = new URL('#attraction', Astro.site).href;

const breadcrumbSchema = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: new URL(crumb.href, Astro.site).href,
      })),
    }
  : null;

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': attractionId,
  name: facts.name,
  alternateName: facts.alternateName,
  description,
  url: canonical.href,
  isAccessibleForFree: true,
  publicAccess: true,
  address: {
    '@type': 'PostalAddress',
    postalCode: '310-0851',
    addressRegion: '茨城県',
    addressLocality: '水戸市',
    streetAddress: '千波町3080',
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: facts.latitude,
    longitude: facts.longitude,
  },
};

const allData = breadcrumbSchema
  ? [breadcrumbSchema, attractionSchema, ...structuredData]
  : [attractionSchema, ...structuredData];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17312a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Senba Park" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="千波湖の穏やかな水辺と緑" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    {allData.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)}></script>
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <SubpageHeader />
    {breadcrumbs.length > 0 && (
      <nav aria-label="パンくずリスト" class="border-b border-[#17312a]/8 bg-white/45">
        <div class="container-page flex flex-wrap items-center gap-1 py-3 text-xs text-[#62736d]">
          <a href="/" class="hover:text-[#38584b]">千波公園ガイド</a>
          {breadcrumbs.map((crumb) => (
            <span class="flex items-center gap-1">
              <span class="px-1 text-[#9aa8a2]">/</span>
              <a href={crumb.href} class="hover:text-[#38584b]">{crumb.name}</a>
            </span>
          ))}
        </div>
      </nav>
    )}
    <main id="main-content">
      <slot />
    </main>
    <SubpageFooter />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
