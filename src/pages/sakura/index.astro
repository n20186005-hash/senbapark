---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import FaqList from '../../components/FaqList.astro';

export const prerender = true;

const title = '千波公園・千波湖の桜｜見頃・おすすめ散歩コース';
const description = '千波公園・千波湖の桜を解説。湖畔には多くの桜が並び、花の時期は早い時間の散歩がおすすめ。見頃の目安や撮影のポイント、周辺の過ごし方をまとめました。';
const breadcrumbs = [{ name: '桜', href: '/sakura/' }];

const faqItems = [
  {
    question: '千波公園の桜の見頃はいつですか？',
    answer: '湖畔の桜並木は例年4月上旬から中旬ごろが見頃の目安です。年の気温によって前後するため、訪問前に開花情報をご確認ください。',
  },
  {
    question: '桜の時期のおすすめの過ごし方は？',
    answer: '花の時期は早い時間ほど歩きやすく、朝の光と湖面のコントラストが楽しめます。湖畔を半周または一周し、ベンチやカフェで休むのがおすすめです。',
  },
  {
    question: '混雑はどのくらいですか？',
    answer: '花の時期や週末は駐車場・園内が混みやすくなります。時間に余裕を持ち、公共交通の利用も検討してください。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<SubpageLayout title={title} description={description} breadcrumbs={breadcrumbs} structuredData={[faqSchema]}>
  <section class="relative overflow-hidden bg-[#17312a] text-white">
    <div class="container-page py-16 sm:py-20">
      <div class="max-w-3xl reveal">
        <span class="section-kicker !text-[#bcd3c8]">桜</span>
        <h1 class="mt-4 font-serif text-[clamp(2.2rem,6vw,4rem)] leading-[1.05] tracking-[-.03em]">千波公園の<br />桜を楽しむ</h1>
        <p class="mt-5 text-base leading-8 text-white/76 sm:text-lg">「千波湖 桜」「千波公園 桜」で調べる方へ。湖畔に並ぶ桜の見頃の目安と、花の時期の散歩のコツをまとめました。</p>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end">
        <div>
          <span class="section-kicker">桜並木</span>
          <h2 class="section-title">湖を囲む、<br />桜の季節。</h2>
        </div>
        <p class="section-lead lg:pb-2">千波公園の湖畔には多くの桜が並びます。花の時期は早い時間ほど歩きやすく、湖面に映る花や噴水との組み合わせが楽しめます。</p>
      </div>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        <article class="surface overflow-hidden lg:col-span-2">
          <div class="grid h-full md:grid-cols-[1.15fr_.85fr]">
            <picture class="min-h-64">
              <source srcset="/images/senba-sakura.webp" type="image/webp" />
              <img src="/images/senba-sakura.jpg" alt="千波公園（Senba Park）の桜並木と千波湖、茨城県水戸市" class="size-full object-cover" width="4000" height="3000" loading="lazy" />
            </picture>
            <div class="p-7 sm:p-9">
              <span class="tag">見頃</span>
              <h3 class="mt-5 font-serif text-3xl leading-snug">花の時期の散歩</h3>
              <p class="mt-3 text-sm text-[#60716a]">例年4月上旬〜中旬ごろが見頃の目安。開花状況は年の気温で変わるため、訪問前の確認をおすすめします。</p>
            </div>
          </div>
        </article>
        <article class="surface p-7 sm:p-9">
          <span class="tag">撮影</span>
          <h3 class="mt-5 font-serif text-3xl leading-snug">朝の光と湖面</h3>
          <p class="mt-3 text-sm text-[#60716a]">静かな水面と花、噴水を重ねるなら朝。混雑を避けつつ落ち着いて撮影できます。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-shell bg-[#e9f0ea]">
    <div class="container-page">
      <div class="mb-10 grid gap-6 lg:grid-cols-[1fr_.8fr] lg:items-end">
        <div><span class="section-kicker">花の時期の過ごし方</span><h2 class="section-title">桜を楽しむ<br />小さな工夫。</h2></div>
        <p class="section-lead">花の時期は混雑しやすいため、時間帯と動線を少し工夫するだけで体験が変わります。</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <article class="rounded-3xl bg-white/72 p-6 shadow-sm"><h3 class="font-serif text-xl text-[#17312a]">早い時間を狙う</h3><p class="mt-3 text-sm text-[#60716a]">開花時は朝の散策が比較的空きやすく、光のコントラストも美しいです。</p></article>
        <article class="rounded-3xl bg-white/72 p-6 shadow-sm"><h3 class="font-serif text-xl text-[#17312a]">半周でも十分</h3><p class="mt-3 text-sm text-[#60716a]">時間がない日は景色のよい区間を往復するだけでも桜を楽しめます。</p></article>
        <article class="rounded-3xl bg-[#17312a] p-6 text-white shadow-sm"><h3 class="font-serif text-xl">カフェでひと休み</h3><p class="mt-3 text-sm text-white/70">好文カフェ周辺などで湖を見ながら軽食をとると、花の散歩が一段落着きます。</p></article>
        <article class="rounded-3xl bg-[#17312a] p-6 text-white shadow-sm"><h3 class="font-serif text-xl">混雑日に備える</h3><p class="mt-3 text-sm text-white/70">週末や満開時は駐車場が混みます。公共交通や早めの到着がおすすめです。</p></article>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="container-page grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
      <div><span class="section-kicker">よくある質問</span><h2 class="section-title">桜の<br />よくある質問</h2></div>
      <FaqList items={faqItems} />
    </div>
  </section>
</SubpageLayout>
