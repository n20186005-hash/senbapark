---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ItineraryPlanner from '../components/ItineraryPlanner.astro';
import MemorialCard from '../components/MemorialCard.astro';
import HistoryLegend from '../components/HistoryLegend.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import TransportGuide from '../components/TransportGuide.astro';
import VisitorServices from '../components/VisitorServices.astro';
import SeasonalStrategy from '../components/SeasonalStrategy.astro';
import RoutesByGroup from '../components/RoutesByGroup.astro';
import GeneralRoutes from '../components/GeneralRoutes.astro';
import ScienceResponsibility from '../components/ScienceResponsibility.astro';
import { facts, faqItems } from '../data/site';

export const prerender = true;

if (!Astro.site) throw new Error('Astro site configuration is required.');

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrls = [
  '/images/senba-hero.jpg',
  '/images/senba-sakura.jpg',
  '/images/senba-sunset.jpg',
].map((path) => new URL(path, Astro.site).href);

const title = '千波公園・千波湖ガイド｜駐車場・一周3km・アクセス・見どころ';
const description = '茨城県水戸市の千波公園・千波湖を楽しむ観光ガイド。駐車場の料金と無料利用日、湖畔一周約3kmの散歩コース、水戸駅からのアクセス、桜の見どころを紹介します。';

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Park'],
  '@id': new URL('#attraction', Astro.site).href,
  name: facts.name,
  alternateName: facts.alternateName,
  description,
  url: canonical.href,
  image: imageUrls,
  sameAs: [facts.govTourismUrl],
  isAccessibleForFree: true,
  address: {
    '@type': 'PostalAddress',
    postalCode: '310-0851',
    addressRegion: '茨城県',
    addressLocality: '水戸市',
    streetAddress: '千波町3080',
    addressCountry: 'JP',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: facts.latitude,
    longitude: facts.longitude,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'https://schema.org/Monday',
      'https://schema.org/Tuesday',
      'https://schema.org/Wednesday',
      'https://schema.org/Thursday',
      'https://schema.org/Friday',
      'https://schema.org/Saturday',
      'https://schema.org/Sunday',
    ],
    opens: '00:00',
    closes: '23:59',
  },
  publicAccess: true,
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: '湖畔散策路', value: true },
    { '@type': 'LocationFeatureSpecification', name: '周辺駐車場', value: true },
    { '@type': 'LocationFeatureSpecification', name: '飲食施設', value: true },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical.href}#faq-schema`,
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const mapUrl = `https://www.google.com/maps/search/?api=1&query=${facts.latitude},${facts.longitude}`;
---

<BaseLayout title={title} description={description} structuredData={[attractionSchema, faqSchema]}>
  <div id="top"></div>
  <SiteHeader />

  <main id="main-content">
    <section class="relative min-h-[92svh] overflow-hidden bg-[#17312a] text-white">
      <picture class="absolute inset-0">
        <source srcset="/images/senba-hero.webp" type="image/webp" />
        <img src="/images/senba-hero.jpg" alt="千波公園（Senba Park）の千波湖畔、茨城県水戸市、日本" class="size-full object-cover object-center" width="2560" height="1920" fetchpriority="high" />
      </picture>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(12,35,29,.88)_0%,rgba(12,35,29,.58)_44%,rgba(12,35,29,.18)_74%),linear-gradient(0deg,rgba(12,35,29,.72)_0%,transparent_45%)]"></div>
      <div class="absolute inset-0 opacity-10 soft-grid"></div>

      <div class="container-page relative flex min-h-[92svh] items-end pb-14 pt-32 sm:pb-20 lg:items-center lg:pb-10">
        <div class="max-w-4xl reveal">
          <div class="mb-6 flex flex-wrap items-center gap-3 text-xs font-bold tracking-[.12em] text-white/78">
            <span class="rounded-full border border-white/20 bg-white/10 px-4 py-2 backdrop-blur">水戸駅から歩ける湖畔</span>
            <span>茨城・水戸</span>
          </div>
          <p class="font-serif text-lg tracking-[.2em] text-white/78 sm:text-xl">水戸の日常に、ひらく水辺。</p>
          <h1 class="mt-3 font-serif text-[clamp(3.2rem,11vw,8rem)] leading-[.9] tracking-[-.06em]">千波公園・千波湖</h1>
          <p class="mt-5 max-w-2xl text-base leading-8 text-white/76 sm:text-lg">約3kmの湖畔を歩き、白鳥を眺め、夕映えを待つ。偕楽園とまちなかを結ぶ、水戸らしい一日の入口です。</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn-primary !border-white !bg-white !text-[#17312a]" href="#guide">過ごし方を選ぶ</a>
            <a class="btn-secondary !border-white/25 !bg-white/10 !text-white backdrop-blur" href={mapUrl} target="_blank" rel="noopener noreferrer">地図を開く<span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>

      <div class="container-page relative -mt-5 pb-8 lg:absolute lg:inset-x-0 lg:bottom-4 lg:mt-0">
        <dl class="grid overflow-hidden rounded-2xl border border-white/15 bg-[#17312a]/66 backdrop-blur-xl sm:grid-cols-4">
          <div class="border-white/12 p-5 sm:border-r"><dt class="text-[.66rem] font-bold tracking-[.16em] text-white/50">湖畔一周</dt><dd class="mt-1 font-serif text-2xl">{facts.loopDistance}</dd></div>
          <div class="border-t border-white/12 p-5 sm:border-r sm:border-t-0"><dt class="text-[.66rem] font-bold tracking-[.16em] text-white/50">入園料</dt><dd class="mt-1 font-serif text-2xl">無料</dd></div>
          <div class="border-t border-white/12 p-5 sm:border-r sm:border-t-0"><dt class="text-[.66rem] font-bold tracking-[.16em] text-white/50">利用時間</dt><dd class="mt-1 font-serif text-2xl">24時間</dd></div>
          <div class="border-t border-white/12 p-5 sm:border-t-0"><dt class="text-[.66rem] font-bold tracking-[.16em] text-white/50">滞在目安</dt><dd class="mt-1 font-serif text-2xl">{facts.stay}</dd></div>
        </dl>
      </div>
    </section>

    <nav aria-label="クイックナビ" class="border-y border-[#17312a]/8 bg-white/45 py-6">
      <div class="container-page">
        <div class="flex flex-wrap gap-3">
          <a class="rounded-full border border-[#17312a]/15 px-5 py-2.5 text-sm font-bold text-[#17312a] transition hover:bg-[#17312a] hover:text-white" href="/parking/">🅿️ 駐車場ガイド</a>
          <a class="rounded-full border border-[#17312a]/15 px-5 py-2.5 text-sm font-bold text-[#17312a] transition hover:bg-[#17312a] hover:text-white" href="/walking-course/">🚶 千波湖一周（何分？）</a>
          <a class="rounded-full border border-[#17312a]/15 px-5 py-2.5 text-sm font-bold text-[#17312a] transition hover:bg-[#17312a] hover:text-white" href="/access/">🚆 アクセス・行き方</a>
          <a class="rounded-full border border-[#17312a]/15 px-5 py-2.5 text-sm font-bold text-[#17312a] transition hover:bg-[#17312a] hover:text-white" href="#weather">🌤️ 今日の天気</a>
        </div>
      </div>
    </nav>

    <section id="guide" class="section-shell overflow-hidden">
      <div class="container-page">
        <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end">
          <div>
            <span class="section-kicker">初めての千波湖</span>
            <h2 class="section-title">湖を中心に、<br />一日の速度を落とす。</h2>
          </div>
          <p class="section-lead lg:pb-2">千波公園は「何かを見る」だけでなく、歩く、座る、食べる、季節を感じる時間そのものが魅力。初めてなら湖畔を半周または一周し、気分に合わせて偕楽園や美術館へ足を延ばすのが自然です。</p>
        </div>

        <div class="mt-12 grid gap-5 lg:grid-cols-3">
          <article class="surface overflow-hidden lg:col-span-2">
            <div class="grid h-full md:grid-cols-[1.15fr_.85fr]">
              <picture class="min-h-72">
                <source srcset="/images/senba-walk.webp" type="image/webp" />
                <img src="/images/senba-walk.jpg" alt="千波公園（Senba Park）の湖畔散策路、茨城県水戸市" class="size-full object-cover" width="960" height="540" loading="lazy" />
              </picture>
              <div class="p-7 sm:p-9">
                <span class="tag">定番</span>
                <h3 class="mt-5 font-serif text-3xl leading-snug">湖畔ウォーク</h3>
                <p class="mt-3 text-sm text-[#60716a]">一周約3km。景色を眺めながらゆっくり歩くなら45〜70分ほど。半周でも十分に水辺の空気を味わえます。</p>
                <ul class="mt-6 space-y-2 text-sm font-bold">
                  <li>・歩きやすい靴がおすすめ</li>
                  <li>・ランナーと自転車に配慮</li>
                  <li>・水分と日差し対策を用意</li>
                </ul>
              </div>
            </div>
          </article>

          <article class="surface p-7 sm:p-9">
            <span class="tag">写真</span>
            <h3 class="mt-5 font-serif text-3xl leading-snug">朝と夕方の光</h3>
            <p class="mt-3 text-sm text-[#60716a]">静かな水面を狙うなら朝。湖面の色と噴水、街の灯りを重ねるなら夕方から日没後が向いています。</p>
            <div class="mt-8 border-t border-[#17312a]/10 pt-5 text-xs text-[#66756f]">季節・天候・イベントによって景観や混雑は変わります。</div>
          </article>

          <article class="surface p-7 sm:p-9">
            <span class="tag">家族</span>
            <h3 class="mt-5 font-serif text-3xl leading-snug">水辺でゆっくり</h3>
            <p class="mt-3 text-sm text-[#60716a]">全部を歩かず、ベンチや芝生、カフェ周辺を中心に。子どものペースで短く区切ると無理なく過ごせます。</p>
          </article>

          <article class="surface overflow-hidden lg:col-span-2">
            <div class="grid h-full md:grid-cols-[.85fr_1.15fr]">
              <div class="order-2 p-7 sm:p-9 md:order-1">
                <span class="tag">季節</span>
                <h3 class="mt-5 font-serif text-3xl leading-snug">桜と新緑をつなぐ道</h3>
                <p class="mt-3 text-sm text-[#60716a]">湖畔には多くの桜が並びます。花の時期は早い時間ほど歩きやすく、花後の新緑や冬の澄んだ空気にも別の美しさがあります。</p>
                <p class="mt-5 text-xs text-[#7b8883]">開花・紅葉の時期は年ごとに変わります。</p>
              </div>
              <picture class="order-1 min-h-72 md:order-2">
                <source srcset="/images/senba-sakura.webp" type="image/webp" />
                <img src="/images/senba-sakura.jpg" alt="千波公園（Senba Park）の桜並木と千波湖、茨城県水戸市" class="size-full object-cover" width="4000" height="3000" loading="lazy" />
              </picture>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="loop" class="section-shell bg-[#e9f0ea]">
      <div class="container-page">
        <div class="mb-10 grid gap-6 lg:grid-cols-[1fr_.8fr] lg:items-end">
          <div>
            <span class="section-kicker">千波湖一周</span>
            <h2 class="section-title">千波湖を一周する<br />距離と所要時間。</h2>
          </div>
          <p class="section-lead">「千波湖は一周すると何分？」よく聞かれる質問です。舗装された周回路なので、ベビーカーや車いすでも周回しやすく、ペースに合わせて選べます。</p>
        </div>

        <div class="grid gap-5 lg:grid-cols-12">
          <article class="surface p-7 sm:p-9 lg:col-span-7">
            <p class="text-xs font-extrabold tracking-[.15em] text-[#6c8177]">周回の目安</p>
            <dl class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
              <div class="rounded-2xl bg-white/60 p-4"><dt class="text-xs text-[#8a988f]">距離</dt><dd class="mt-1 font-serif text-2xl text-[#17312a]">約3km</dd></div>
              <div class="rounded-2xl bg-white/60 p-4"><dt class="text-xs text-[#8a988f]">徒歩</dt><dd class="mt-1 font-serif text-2xl text-[#17312a]">約35〜40分</dd></div>
              <div class="rounded-2xl bg-white/60 p-4"><dt class="text-xs text-[#8a988f]">ジョギング</dt><dd class="mt-1 font-serif text-2xl text-[#17312a]">約15〜20分</dd></div>
              <div class="rounded-2xl bg-white/60 p-4"><dt class="text-xs text-[#8a988f]">自転車</dt><dd class="mt-1 font-serif text-2xl text-[#17312a]">約10分</dd></div>
            </dl>
            <p class="mt-5 text-sm text-[#60716a]">景色を眺めながらゆっくり歩くなら45〜70分ほど。半周でも十分に水辺の空気を味わえます。</p>
          </article>

          <article class="rounded-[1.6rem] bg-[#17312a] p-7 text-white sm:p-9 lg:col-span-5">
            <p class="text-xs font-extrabold tracking-[.15em] text-white/50">一周の見どころ</p>
            <ul class="mt-5 space-y-3 text-sm text-white/78">
              <li>・白鳥・黒鳥の観察スポット</li>
              <li>・スワンボート乗り場（季節運航）</li>
              <li>・好文カフェで湖を眺める休憩</li>
              <li>・桜並木と湖上噴水の景色</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <HistoryLegend />
    <WeatherWidget />

    <section class="section-shell bg-[#e9f0ea]">
      <div class="container-page">
        <div class="grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
          <div>
            <span class="section-kicker">滞在プラン</span>
            <h2 class="section-title">滞在時間と、<br />おすすめの時間帯。</h2>
            <p class="section-lead">目的を一つ決めると、広い園内でも迷いません。</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <article class="rounded-3xl bg-white/72 p-6 shadow-sm"><p class="text-xs font-extrabold tracking-[.15em] text-[#6c8177]">約60分</p><h3 class="mt-2 font-serif text-2xl">短時間の湖畔散歩</h3><p class="mt-3 text-sm text-[#60716a]">水戸駅側から湖畔へ入り、景色のよい区間を往復。カフェ休憩を一つ加える程度。</p></article>
            <article class="rounded-3xl bg-white/72 p-6 shadow-sm"><p class="text-xs font-extrabold tracking-[.15em] text-[#6c8177]">90〜150分</p><h3 class="mt-2 font-serif text-2xl">一周してゆっくり</h3><p class="mt-3 text-sm text-[#60716a]">一周約3kmに、撮影、ベンチ休憩、軽食を組み合わせる基本プラン。</p></article>
            <article class="rounded-3xl bg-[#17312a] p-6 text-white shadow-sm"><p class="text-xs font-extrabold tracking-[.15em] text-white/50">早朝</p><h3 class="mt-2 font-serif text-2xl">静けさを楽しむ朝</h3><p class="mt-3 text-sm text-white/65">人の少ない時間に歩きたい人、湖面の反射や鳥を撮りたい人向け。</p></article>
            <article class="rounded-3xl bg-[#17312a] p-6 text-white shadow-sm"><p class="text-xs font-extrabold tracking-[.15em] text-white/50">夕方</p><h3 class="mt-2 font-serif text-2xl">夕映えを待つ</h3><p class="mt-3 text-sm text-white/65">散歩の終盤を日没前に合わせ、湖面の色が変わる時間をゆっくり過ごす。</p></article>
          </div>
        </div>
      </div>
    </section>

    <section id="reviews" class="section-shell bg-[#f0ebe3]">
      <div class="container-page">
        <div class="mb-10 grid gap-6 lg:grid-cols-[1fr_.8fr] lg:items-end">
          <div>
            <span class="section-kicker">Google マップの評価</span>
            <h2 class="section-title">評価と口コミ</h2>
          </div>
          <p class="section-lead">評価は Google マップ（Google Maps）のユーザー評価に基づき表示しています。すべての評価は <a href={facts.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="font-bold text-[#38584b] underline underline-offset-4">谷歌地图用户评价 ↗</a> からご確認いただけます。</p>
        </div>

        <div class="grid gap-5 lg:grid-cols-12">
          <article class="surface p-7 sm:p-9 lg:col-span-5">
            <p class="text-xs font-extrabold tracking-[.15em] text-[#6c8177]">Google マップ総合評価</p>
            <div class="mt-3 flex items-end gap-3">
              <span class="font-serif text-7xl leading-none text-[#17312a]">{facts.ratingValue.toFixed(1)}</span>
              <span class="pb-2 text-sm text-[#62736d]">/ 5</span>
            </div>
            <p class="mt-3 text-sm text-[#62736d]">{facts.ratingCount.toLocaleString()} 件の評価</p>
            <a href={facts.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-7 w-full sm:w-auto">在谷歌地图查看全部评价 <span aria-hidden="true">↗</span></a>
          </article>

          <article class="rounded-[1.6rem] bg-[#17312a] p-7 text-white sm:p-9 lg:col-span-7">
            <p class="text-xs font-extrabold tracking-[.15em] text-white/50">评价来源说明</p>
            <p class="mt-4 text-sm leading-relaxed text-white/72">同步自 Google 地图用户评价，同步时间 2026 年 10 月；版权归原作者与 Google 地图所有</p>
          </article>
        </div>

        <p class="mt-6 text-xs text-[#7b8883]">评分与评价数同步自谷歌地图（Google Maps）用户评价 · 2026 年 10 月 · <a href={facts.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[#38584b]">点击查看谷歌地图全部评价↗</a></p>
      </div>
    </section>

    <section id="access" class="section-shell">
      <div class="container-page">
        <div class="mb-12 grid gap-6 lg:grid-cols-[1fr_.8fr] lg:items-end">
          <div><span class="section-kicker">交通・駐車場</span><h2 class="section-title">駅から歩く。<br />車なら余白を持つ。</h2></div>
          <p class="section-lead">水戸駅から徒歩で向かえるのが千波公園の強みです。週末や花の季節、催しの日は周辺道路と駐車場が混みやすいため、公共交通も選択肢に。</p>
        </div>

        <div class="grid gap-5 lg:grid-cols-12">
          <article class="surface p-7 lg:col-span-7 sm:p-9">
            <div class="flex items-start justify-between gap-5"><div><span class="tag">電車・徒歩</span><h3 class="mt-4 font-serif text-3xl">JR水戸駅から</h3></div><span class="font-serif text-5xl text-[#9caf9f]">01</span></div>
            <ol class="mt-7 space-y-5 border-l border-[#17312a]/15 pl-6 text-sm">
              <li><strong class="block text-base">南口から徒歩</strong><span class="text-[#62736d]">駅を出て千波湖方面へ。目安は約15分。天候がよければ最も分かりやすい移動です。</span></li>
              <li><strong class="block text-base">北口から路線バス</strong><span class="text-[#62736d]">北口6番のりばから千波湖・偕楽園方面へ。降車停留所と運行時刻は当日の案内を確認してください。</span></li>
            </ol>
          </article>

          <article class="surface p-7 lg:col-span-5 sm:p-9">
            <div class="flex items-start justify-between gap-5"><div><span class="tag">車</span><h3 class="mt-4 font-serif text-3xl">高速道路から</h3></div><span class="font-serif text-5xl text-[#9caf9f]">02</span></div>
            <dl class="mt-7 space-y-4 text-sm"><div class="border-b border-[#17312a]/10 pb-4"><dt class="font-bold">常磐自動車道 水戸IC</dt><dd class="mt-1 text-[#62736d]">一般道でおよそ30分が目安。</dd></div><div><dt class="font-bold">北関東自動車道 水戸南IC</dt><dd class="mt-1 text-[#62736d]">一般道でおよそ20分が目安。</dd></div></dl>
          </article>

          <article id="parking" class="rounded-[1.6rem] bg-[#17312a] p-7 text-white lg:col-span-12 sm:p-9">
            <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr]">
              <div>
                <span class="section-kicker !text-[#bcd3c8]">駐車場</span>
                <h3 class="mt-3 font-serif text-4xl">駐車場情報</h3>
                <p class="mt-3 text-sm text-white/62">千波湖の周りには複数の駐車場があり、無料の場所と有料の場所が混在します。場所ごとに料金や利用時間が異なるため、現地の表示を確認してください。</p>
                <div class="mt-5 flex flex-wrap gap-3">
                  <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="inline-block rounded-full border border-white/20 px-5 py-2 text-xs font-bold hover:bg-white/10">周辺の駐車場を地図で ↗</a>
                  <a href="/parking/" class="inline-block rounded-full bg-white px-5 py-2 text-xs font-bold text-[#17312a] hover:bg-white/90">料金・無料の目安を詳しく見る →</a>
                </div>
              </div>
              <div class="grid gap-3 sm:grid-cols-3">
                <div class="rounded-2xl bg-white/8 p-5"><strong class="block">千波公園西駐車場</strong><span class="mt-2 block text-sm text-white/60">湖の西側、湖畔まで近い。有料の傾向があります。</span></div>
                <div class="rounded-2xl bg-white/8 p-5"><strong class="block">湖南駐車場</strong><span class="mt-2 block text-sm text-white/60">湖の南側、偕楽園方面への動線に便利。</span></div>
                <div class="rounded-2xl bg-white/8 p-5"><strong class="block">偕楽園下駐車場</strong><span class="mt-2 block text-sm text-white/60">偕楽園利用時に便利。花の季節は満車しやすい。</span></div>
              </div>
            </div>
            <div class="mt-7 grid gap-3 border-t border-white/10 pt-6 sm:grid-cols-3">
              <div class="text-xs text-white/60"><span class="font-bold text-white/80">料金</span>：駐車場ごとに異なります。入口の表示を確認。</div>
              <div class="text-xs text-white/60"><span class="font-bold text-white/80">時間</span>：入出庫できる時間が異なり、夜間は特に注意。</div>
              <div class="text-xs text-white/60"><span class="font-bold text-white/80">混雑</span>：桜・梅・大型イベント時は早めの到着を。</div>
            </div>
            <p class="mt-5 text-xs text-white/48">料金・利用時間・交通規制は変更されることがあります。現地表示を優先してください。</p>
