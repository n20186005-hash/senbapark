{
  "name": "senba-park-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "audit:source": "node scripts/audit-source.mjs",
    "audit:lock": "node scripts/audit-lock.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "verify:clean": "bash scripts/verify-clean.sh",
    "deploy": "pnpm build && node scripts/deploy-with-retry.mjs",
    "deploy:ci": "pnpm build && sh -c 'n=0; max=3; until [ $n -ge $max ]; do n=$((n+1)); echo \"=== wrangler deploy 尝试 $n/$max ===\"; npx wrangler deploy --force && break; code=$?; echo \"⚠ wrangler deploy 失败(退出 $code)，疑似 Cloudflare API 瞬时 520/521，准备重试\"; [ $n -lt $max ] && sleep $((5 * 2**(n-1))); done; [ $n -lt $max ] || [ -z \"$code\" ]'"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.7",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.116.0"
  }
}
